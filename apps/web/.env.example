VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
CREDENTIAL_ENCRYPTION_KEY=
DO_TOKEN=

# Platform default AI model (optional) — auto-assigned to new deployments
PLATFORM_DEFAULT_MODEL=
BYTEPLUS_ARKMODEL_API_KEY=

# Platform-managed Tailscale — set both to enable auto-provisioning
# Get API token from Tailscale admin → Settings → Keys (tskey-api-* prefix)
# Tailnet is your tailnet domain (e.g., yourplatform.tail1a2b3.ts.net)
TAILSCALE_API_TOKEN=
TAILSCALE_TAILNET=
